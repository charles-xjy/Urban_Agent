# ── vLLM 服务（模型名启动时自动查询，无需手填）────────────────────────────────
# AGENT_MODEL_NAME=   # 如需覆盖自动查询结果，取消注释
# CLAIM_MODEL_NAME=
BASE_LLM_URL="http://your_vllm_server:port/v1"

# ── Google Earth Engine ───────────────────────────────────────────────────────
GEE_PROJECT=ee-yourproject

# ── 代理（GEE + DuckDuckGo 国内访问需要）────────────────────────────────────
HTTP_PROXY=http://127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897

# ── 高德地图（地名 → 经纬度）─────────────────────────────────────────────────
GAODE_API_KEY=your_gaode_api_key

# ── 百度地图（可选）───────────────────────────────────────────────────────────
# BAIDU_MAP_AK=your_baidu_map_ak
# BAIDU_API_KEY=your_baidu_api_key

# ── 知乎登录态（可选，用于抓取知乎专栏）────────────────────────────────────
# ZHIHU_COOKIE="your_zhihu_cookie"

# ── LangSmith 追踪（可选）────────────────────────────────────────────────────
# LANGSMITH_API_KEY=
# LANGCHAIN_TRACING_V2=true

# ── 评分阈值（可选，默认 75）──────────────────────────────────────────────────
# CLAIM_THRESHOLD=75
