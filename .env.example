# ── vLLM 服务（模型名启动时自动查询，无需手填）────────────────────────────────
# AGENT_MODEL_NAME=   # 如需覆盖自动查询结果，取消注释
# CLAIM_MODEL_NAME=

# ── Google Earth Engine ───────────────────────────────────────────────────────
GEE_PROJECT=ee-yourproject

# ── 代理（GEE + DuckDuckGo 国内访问需要）────────────────────────────────────
HTTP_PROXY=http://127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897

# ── 高德地图（地名 → 经纬度）─────────────────────────────────────────────────
GAODE_API_KEY=your_gaode_api_key

# ── Jina Reader（国际网页全文抓取，免费注册可获得 500 RPM 额度）──────────────
JINA_API_KEY=your_jina_api_key

# ── InfoQuest / BytePlus（中国网页抓取，服务器在国内）────────────────────────
INFOQUEST_API_KEY=your_infoquest_api_key

# ── LangSmith 追踪（可选）────────────────────────────────────────────────────
# LANGSMITH_API_KEY=
# LANGCHAIN_TRACING_V2=true

# ── 评分阈值（可选，默认 75）──────────────────────────────────────────────────
# CLAIM_THRESHOLD=75
